# Optional. Used by scripts/query-nearby.js and local simulation.
DEFAULT_LAT=4.7110
DEFAULT_LON=-74.0721
DEFAULT_TIMEZONE=America/Bogota

# Search window
LOOKBACK_HOURS=48
SEARCH_RADIUS_KM=250
MIN_MAGNITUDE=3
MAX_EVENTS_TO_SPEAK=3

# Timeouts must stay well under Alexa's 8s skill limit
HTTP_TIMEOUT_MS=3500

# Identify this client to USGS/EMSC/Nominatim
USER_AGENT=SismosCercanosAlexa/1.0 (https://github.com/local/sismos-cercanos)

# Solo para desarrollo local si un antivirus intercepta HTTPS (nunca en Lambda)
# NODE_TLS_REJECT_UNAUTHORIZED=0

NOMINATIM_URL=https://nominatim.openstreetmap.org
EMSC_FDSN_URL=https://www.seismicportal.eu/fdsnws/event/1/query
USGS_FDSN_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
